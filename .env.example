# ============================================================
# Environment Configuration Template
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# --- Graph Database (Memgraph) ---
GRAPH_DB_ENGINE=memgraph
GRAPH_DB_URI=bolt://localhost:7687
GRAPH_DB_USER=
GRAPH_DB_PASSWORD=

# --- Legacy Neo4j (migration only) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# --- LLM Provider API Keys ---

# GEMINI API
GEMINI_API_KEY=your_gemini_api_key_here

# LLM7.io API
LLM7_BASE_URL="https://api.llm7.io/v1"
LLM7_API_KEY=your_llm7_api_key_here

# NVIDIA API Key
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenAI API
# OPENAI_BASE_URL=  # Optional; leave unset for OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# --- Data Paths ---
# Use project-relative paths (e.g. data/raw/twitter/... ) where possible.
DATA_ROOT=data/raw

## --- Text Embeddings Inference (TEI) Client ---
## Application-side settings for calling the TEI server.
#TEI_BASE_URL=http://127.0.0.1:8080
## TEI_API_KEY=              # Optional: set if TEI is started with API_KEY auth
#TEI_CLIENT_BATCH_SIZE=32
#TEI_TIMEOUT_SECONDS=60.0

# -----------------------------------------------------------------------------
# TEI profile 1: Community Evolution thematic similarity
# Application client defaults to http://127.0.0.1:8080.
# Keep the model aligned with the similarity_model analytical configuration.
# -----------------------------------------------------------------------------
TEI_BASE_URL=http://127.0.0.1:8080
TEI_API_KEY=
TEI_CLIENT_BATCH_SIZE=32
TEI_TIMEOUT_SECONDS=60

TEI_SIMILARITY_HOST_PORT=8080
TEI_SIMILARITY_MODEL_ID=sentence-transformers/paraphrase-MiniLM-L6-v2
TEI_SIMILARITY_REVISION=
TEI_SIMILARITY_CONTAINER_NAME=community-analysis-tei-similarity

# -----------------------------------------------------------------------------
# TEI profile 2: Thematic Analysis theme clustering / canonicalization
# Application client defaults to http://127.0.0.1:8081.
# Keep the model aligned with theme.clustering_model in configs/algorithms.yml.
# -----------------------------------------------------------------------------
TEI_CLUSTERING_BASE_URL=http://127.0.0.1:8081
TEI_CLUSTERING_API_KEY=
TEI_CLUSTERING_CLIENT_BATCH_SIZE=32
TEI_CLUSTERING_TIMEOUT_SECONDS=60

TEI_CLUSTERING_HOST_PORT=8081
TEI_CLUSTERING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
TEI_CLUSTERING_REVISION=
TEI_CLUSTERING_CONTAINER_NAME=community-analysis-tei-clustering

# -----------------------------------------------------------------------------
# Theme analysis providers
# Production/default behavior uses TEI. `mock` is intended for controlled tests.
# -----------------------------------------------------------------------------
THEME_CLUSTERING_PROVIDER=tei
THEME_SIMILARITY_PROVIDER=tei
THEME_SIMILARITY_FAILURE_POLICY=fail

# Optional similarity-threshold overrides. Leave blank to use project defaults.
# THEME_SIMILARITY_REPLY_TRANSITION_THRESHOLD=
# THEME_SIMILARITY_DEFAULT_TRANSITION_THRESHOLD=

# -----------------------------------------------------------------------------
# Shared TEI launcher options
# `make tei-up` starts both profiles above; `make tei-check` checks both.
# On Linux without a GPU, the launcher uses its pinned/default CPU TEI image.
# On GPU deployments, TEI_IMAGE must be set explicitly.
# -----------------------------------------------------------------------------
TEI_IMAGE=
TEI_HF_TOKEN=
TEI_REVISION=
TEI_RUNTIME_DIR=.runtime/tei
TEI_TOKENIZATION_WORKERS=
TEI_MAX_CLIENT_BATCH_SIZE=
TEI_MAX_BATCH_TOKENS=
TEI_SKIP_HEALTHCHECK=0

# Backward-compatible launcher fallbacks; normally leave these unset because the
# explicit similarity/clustering profile variables above are preferred.
# TEI_MODEL_ID=
# TEI_HOST_PORT=

# --- Runtime Logging ---
# Use json in ECS/CloudWatch; text is easier for local terminals.
LOG_LEVEL=INFO
LOG_FORMAT=text

## --- Theme Similarity Policy ---
## Production/research runs fail rather than silently switching embedding methods.
## Set both values to mock only for offline tests.
#THEME_SIMILARITY_PROVIDER=tei
#THEME_SIMILARITY_FAILURE_POLICY=fail

# --- Observability (Phase 5) ---
# MLflow tracking URI. Use a local directory for development.
MLFLOW_TRACKING_URI=./mlruns

# Read-only dashboard API
COMMUNITY_ANALYSIS_ARTIFACT_ROOT=local_output
COMMUNITY_ANALYSIS_API_MAX_GRAPH_NODES=1000
COMMUNITY_ANALYSIS_API_MAX_GRAPH_EDGES=5000
COMMUNITY_ANALYSIS_API_CATALOG_REFRESH_SECONDS=1
# Cache only small Parquet artifacts in API process memory (16 MiB default).
COMMUNITY_ANALYSIS_API_PARQUET_CACHE_MAX_BYTES=16777216
# Comma-separated list of allowed CORS origins (default: localhost dev ports)
# COMMUNITY_ANALYSIS_API_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Comma-separated hostnames accepted by TrustedHostMiddleware. Include the ALB
# host/custom domain in AWS; use * only when a trusted reverse proxy enforces it.
# COMMUNITY_ANALYSIS_API_ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
# Optional ASGI root path when the service is mounted below a path prefix.
COMMUNITY_ANALYSIS_API_ROOT_PATH=
# Disable interactive API docs on a public production service if not required.
COMMUNITY_ANALYSIS_API_DOCS_ENABLED=true
COMMUNITY_ANALYSIS_API_GZIP_MINIMUM_SIZE=1024

# Frontend note:
# Vite reads `frontend/.env` / `frontend/.env.example`, not this root file.
# Current frontend example:
#   VITE_API_BASE_URL=/api/v1
