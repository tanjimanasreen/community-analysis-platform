# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.10.0 AS uv

FROM python:3.11-slim-bookworm AS builder
COPY --from=uv /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_MANAGED_PYTHON=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project
COPY src/ src/
COPY configs/ configs/
COPY README.md HARNESS.md ARCHITECTURE.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

FROM python:3.11-slim-bookworm AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    HOME=/home/community \
    LOG_FORMAT=json \
    LOG_LEVEL=INFO \
    COMMUNITY_ANALYSIS_ARTIFACT_ROOT=/artifacts \
    COMMUNITY_ANALYSIS_API_DOCS_ENABLED=false
RUN groupadd --gid 10001 community \
    && useradd --uid 10001 --gid community --create-home community \
    && mkdir -p /artifacts \
    && chown -R community:community /artifacts
WORKDIR /app
COPY --from=builder --chown=community:community /app /app
USER community
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=3)" || exit 1
CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
