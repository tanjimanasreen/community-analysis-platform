VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=30000

# Authentication mode: "local" (default developer mode) or "cognito" (protected CloudFront/Lambda deployment)
VITE_AUTH_MODE=local

# Required only when VITE_AUTH_MODE=cognito:
VITE_COGNITO_USER_POOL_ID=us-east-1_example
VITE_COGNITO_CLIENT_ID=exampleappclientid
VITE_COGNITO_DOMAIN=community-analysis-dev-123456789012.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=https://d1234567890.cloudfront.net
